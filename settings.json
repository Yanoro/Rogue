{
  "_readme": "AIRogue startup settings. Full field reference, including the fields that are not wired yet, is in SETTINGS.md. Put secrets (model.apiKey) in settings.local.json, which is gitignored and merged on top of this file.",

  "map": {
    "file": "./maps/Map_Training.json",
    "spawnNPCs": true,
    "mapsDirectory": "./maps"
  },

  "art": {
    "generation": {
      "source": "dsl"
    }
  },

  "model": {
    "profile": "deepseek-v4-flash"
  },

  "ai": {
    "npcPromptFile": "",
    "memoryDigest": true,
    "memoryDigestMinAgeSeconds": 120,
    "memoryDigestCandidates": 24,
    "memoryDigestStartupGraceSeconds": 60,
    "memoryDigestMinCells": 400,
    "memoryDigestMaxTokens": 1200,
    "memorySalience": false,

    "profiles": {
      "deepseek-v4-flash": {
        "label": "DeepSeek V4 Flash (OpenRouter)",
        "kind": "s2",
        "model": {
          "type": "openrouter",
          "model": "deepseek/deepseek-v4-flash",
          "maxTokens": 1500,
          "provider": {
            "order": [
              "deepinfra",
              "novita",
              "siliconflow",
              "parasail",
              "gmicloud"
            ],
            "allow_fallbacks": false,
            "require_parameters": true
          }
        }
      },
      "phi4-mini": {
        "label": "Phi-4 Mini (Ollama, navigator)",
        "kind": "s2",
        "model": {
          "type": "ollama",
          "model": "phi4-mini:latest",
          "keepAlive": "30m",
          "temperature": 0
        }
      },
      "qwen2.5vl": {
        "label": "Qwen2.5-VL (Ollama vision)",
        "kind": "vision",
        "model": {
          "type": "ollama",
          "model": "qwen2.5vl",
          "keepAlive": "30m"
        }
      },
      "moondream": {
        "label": "Moondream (Ollama vision)",
        "kind": "vision",
        "model": {
          "type": "ollama",
          "model": "moondream",
          "keepAlive": "30m"
        }
      },
      "kev": {
        "label": "Kev-4B (local llama-server)",
        "kind": "s1",
        "preset": "local_kev"
      },
      "jev": {
        "label": "Jev (hosted, OpenRouter)",
        "kind": "s1",
        "preset": "hosted_jev",
        "model": {
          "model": "~typesafe/jev-latest"
        }
      }
    }
  },

  "vision": {
    "enabled": true,
    "profile": "qwen2.5vl"
  },

  "designer": {
    "maxTokens": 3000,
    "tts": {
      "enabled": true,
      "binary": "piper",
      "voice": "models/tts/en_GB-alba-medium.onnx",
      "volume": 1.0,
      "content": "notes"
    }
  },

  "navigation": {
    "agent": "single",
    "single": {
      "maxTokens": 500,
      "contextTokens": 4096,
      "timeoutSeconds": 60,
      "fallbackToTwo": false,
      "mapRadius": 6,
      "useMainModel": false,
      "model": {
        "profile": "phi4-mini"
      },
      "dedicatedBackend": true,
      "disableReasoning": true,
      "compactJson": true,
      "historyTurns": 2,
      "concise": true,
      "objectSummary": true,
      "includeGraph": false,
      "includeMap": false,
      "maxObjectGroups": 6,
      "maxGroupDetails": 8
    }
  },

  "regions": {
      "farRadius": 48
  },

  "chunks": {
    "enabled": true,
    "size": 8,
    "maxTraversedAreas": 8,
    "maxJourneySegments": 12,
    "maxNewAreas": 6,
    "maxFeaturesPerArea": 3,
    "cardAspects": 3,
    "cardObjectGroups": 6,
    "cardPlaces": 4,
    "includeCharacters": true
  },

  "system1": {
    "useMainModel": true,
    "disableReasoning": true,
    "maxRecords": 500,
    "model": {
      "model": "~typesafe/jev-latest"
    },
    "profiles": [
      {
        "id": "kev",
        "label": "Kev-4B (this machine)",
        "profile": "kev"
      },
      {
        "id": "jev",
        "label": "Jev (hosted)",
        "profile": "jev"
      }
    ]
  },
  "window": {
    "title": "AIRogue",
    "width": 1920,
    "height": 1080,
    "fullscreen": true,
    "vsync": true,
    "targetFPS": 60,
    "monitor": -1
  },

  "render": {
    "fontPath": "./fonts/oldschool/otb - Bm (linux bitmap)/BmPlus_IBM_CGA.otb",
    "fontSize": 32,
    "cameraMode": "follow",
    "cameraZoom": 0.0
  },

  "player": {
    "name": "playerCharacter",
    "startX": 12,
    "startY": 48,
    "race": "",
    "portrait": "player"
  },

  "world": {
    "seed": 0
  },

  "content": {
    "objects": "data/objects",
    "recipes": "data/recipes",
    "stats": "data/stats",
    "skills": "data/skills",
    "items": "data/items",
    "races": "data/races",
    "portraits": "data/portraits",
    "projectiles": "data/projectiles"
  },

  "debug": {
    "windowStateFile": "./debug_windows_state.json",
    "restServer": true,
    "logMaxEntries": 1000
  }
}
