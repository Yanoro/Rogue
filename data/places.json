{
  "_readme": "Place categories (docs/place-derivation-design.md section 4). 'formsPlace: true' makes a category a kind: seeds of it cluster into places. 'formsPlace: false' makes it a quality: seeds of it only describe the place they are inside. minSeeds is how many seeds a place needs; radius is both the link distance and how far a place's extent may reach from its seeds.",

  "grass":        { "formsPlace": false, "radius": 6, "regionLabel": "grass field" },
  "sand":         { "formsPlace": false, "radius": 6, "regionLabel": "sand field" },
  "marsh":        { "formsPlace": false, "radius": 5, "regionLabel": "marsh" },
  "rock":         { "formsPlace": false, "radius": 4, "regionLabel": "rocky ground" },
  "path":         { "formsPlace": false, "radius": 3, "regionLabel": "path" },
  "tilled soil":  { "formsPlace": false, "radius": 5, "regionLabel": "tilled field" },
  "packed earth": { "formsPlace": false, "radius": 4, "regionLabel": "packed earth" },

  "orchard":      { "formsPlace": true, "minSeeds": 1, "radius": 4 },
  "field":        { "formsPlace": true, "minSeeds": 4, "radius": 5 },
  "mine":         { "formsPlace": true, "minSeeds": 2, "radius": 4 },
  "workshop":     { "formsPlace": true, "minSeeds": 2, "radius": 4 },
  "storage":      { "formsPlace": true, "minSeeds": 1, "radius": 3 },
  "religious":    { "formsPlace": true, "minSeeds": 2, "radius": 5 },
  "road":         { "formsPlace": true, "minSeeds": 2, "radius": 2, "split": "junctions", "diagonal": true, "linksAcross": false },
  "water":        { "formsPlace": true, "minSeeds": 4, "linksAcross": false, "regionLabel": "water" },
  "market":       { "formsPlace": true, "minSeeds": 3, "radius": 5 },

  "poor":         { "formsPlace": false },
