sprite 32x32
kind object

palette {
  out = #1A1210
  skin_base = #F2C79A
  skin_hi = #FFE0B8
  skin_sh = #C98B60
  iron_hi = stone.4
  iron_mid = stone.2
  iron_sh = iron.1
  wood_base = wood.2
  wood_hi = wood.3
  wood_sh = wood.1
}

// Hammer head (silhouette & outline)
rect (8,3) (23,10) color=out
rect (6,4) (25,9) color=out

// Hammer head fills
rect (7,5) (24,8) color=iron_mid
line (8,4) (23,4) color=iron_hi
line (7,5) (7,8) color=iron_hi
line (9,5) (22,5) color=iron_hi
line (8,9) (23,9) color=iron_sh
line (24,5) (24,8) color=iron_sh

// Central eye/collar of hammer
rect (14,4) (17,10) color=iron_sh
line (15,4) (16,4) color=iron_hi

// Hammer handle (shaft)
rect (14,10) (17,29) color=out
rect (15,10) (16,28) color=wood_base
line (15,10) (15,28) color=wood_hi
line (16,10) (16,28) color=wood_sh

// Single large hand gripping the handle
rect (9,14) (22,23) color=out
rect (10,15) (21,22) color=skin_base

// Thumb wrapping across the shaft from the left
rect (11,13) (18,16) color=out
rect (12,14) (17,15) color=skin_hi
pixel (17,14) color=skin_base

// Fingers wrapped firmly across the front
line (14,17) (20,17) color=skin_hi
line (13,18) (20,18) color=skin_sh
line (14,19) (20,19) color=skin_hi
line (13,20) (20,20) color=skin_sh
line (14,21) (20,21) color=skin_hi
line (13,22) (20,22) color=skin_sh

// Knuckles / side of palm on the right
line (21,16) (21,21) color=skin_hi
pixel (10,18) color=skin_sh
pixel (10,20) color=skin_sh

// Handle butt peeking out at bottom
pixel (15,28) color=wood_hi
pixel (16,28) color=wood_base
line (14,29) (17,29) color=out
