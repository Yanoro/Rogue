sprite 32x32
kind object
material iron

palette {
  out = #1A1210
  light = #FFE0B8
  mid = #b1b0aa
  dark = #2e2e2e
}

// === Anvil Base & Body Silhouette ===
polygon (6,27) (25,27) (23,24) (19,22) (18,19) (26,17) (26,15) (24,14) (8,14) (5,16) (13,19) (12,22) (8,24) color=out
polygon (7,26) (24,26) (22,24) (18,22) (17,19) (25,17) (25,16) (23,15) (9,15) (6,16) (14,19) (13,22) (9,24) color=dark

// Anvil Horn and Face shading (mid tone for upper lit edge)
rect (9,15) (23,16) color=mid
rect (10,17) (18,18) color=mid
pixel (24,16) color=mid
pixel (6,16) color=mid

// Chipped/scarred surface texture on anvil face
pixel (12,15) color=dark
pixel (16,15) color=light
pixel (17,15) color=dark
pixel (20,15) color=light

// Anvil base highlight rim
rect (10,25) (21,25) color=mid

// === Striking Hammer (diagonal impact pose) ===
// Hammer handle outline & fill
line (19,4) (14,12) color=out
line (20,4) (15,12) color=out
line (21,5) (16,13) color=out
line (20,5) (15,12) color=mid

// Hammer head outline
polygon (11,8) (16,4) (19,7) (14,11) color=out
polygon (9,11) (13,7) (16,10) (12,14) color=out

// Hammer head interior
polygon (12,8) (15,5) (18,7) (14,10) color=dark
polygon (10,11) (13,8) (15,10) (12,13) color=mid

// Hammer striking face catching bright highlight
line (10,12) (12,14) color=light
pixel (11,13) color=light
pixel (13,10) color=light

// Sparks / impact nick at striking point
pixel (13,14) color=light
pixel (14,13) color=out
