  pixel (22,16) color=sand.3
  pixel (25,17) color=sand.1
  // Forearm (vertical passing)
  rect (22,19) (25,21) color=sand.2
  pixel (22,19) color=sand.3
  pixel (25,21) color=sand.1
  // Open grip hand
  rect (22,22) (25,23) color=sand.2
  pixel (23,22) color=sand.0
  pixel (22,23) color=sand.3
  // Outline
  line (22,11) (25,11) color=ink.base
  line (26,12) (26,23) color=ink.base
  line (22,24) (25,24) color=ink.base
  pixel (21,12) color=ink.base
  pixel (21,18) color=ink.base
  pixel (21,22) color=ink.base
}

frame "f3" {
  // Shoulder / Deltoid (arm swings backward, slightly upward)
  rect (22,13) (25,16) color=sand.2
  pixel (22,13) color=sand.3
  pixel (23,13) color=sand.3
  pixel (25,16) color=sand.1
