sprite 32x32
kind object
material sand

frame "f1" {
  // Shoulder / Deltoid
  rect (22,13) (25,16) color=sand.2
  pixel (22,13) color=sand.3
  pixel (23,13) color=sand.3
  pixel (25,16) color=sand.1
  // Bicep / Tricep flexed
  rect (22,16) (25,18) color=sand.2
  pixel (22,17) color=sand.3
  pixel (25,18) color=sand.1
  // Forearm & wrist angled forward
  rect (23,19) (26,21) color=sand.2
  pixel (23,19) color=sand.3
  pixel (26,21) color=sand.1
  // Open grip hand
  rect (23,22) (26,23) color=sand.2
  pixel (24,22) color=sand.0
  pixel (23,23) color=sand.3
  // Outline
  line (22,12) (25,12) color=ink.base
  line (26,13) (26,18) color=ink.base
  line (27,19) (27,23) color=ink.base
  line (23,24) (26,24) color=ink.base
  line (22,22) (22,23) color=ink.base
  pixel (21,13) color=ink.base
  pixel (21,18) color=ink.base
}

frame "f2" {
  // Shoulder / Deltoid (body rises 1px)
  rect (22,12) (25,15) color=sand.2
  pixel (22,12) color=sand.3
  pixel (23,12) color=sand.3
  pixel (25,15) color=sand.1
  // Bicep
