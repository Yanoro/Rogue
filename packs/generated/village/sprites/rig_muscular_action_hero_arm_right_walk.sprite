  rect (21,19) (24,21) color=sand.2
  pixel (21,19) color=sand.3
  pixel (24,21) color=sand.1
  // Open grip hand
  rect (21,22) (24,23) color=sand.2
  pixel (22,22) color=sand.0
  pixel (21,23) color=sand.3
  // Outline
  line (22,12) (25,12) color=ink.base
  line (26,13) (26,16) color=ink.base
  line (25,17) (25,23) color=ink.base
  line (21,24) (24,24) color=ink.base
  line (20,17) (20,23) color=ink.base
  pixel (21,13) color=ink.base
}

frame "f4" {
  // Shoulder / Deltoid (body rises 1px, passing forward)
  rect (22,12) (25,15) color=sand.2
