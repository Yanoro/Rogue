sprite 32x32
kind object
material grass

palette {
  orc_dark = #2d451b
  orc_mid = #456b23
  orc_light = #618f33
  wrap_dark = soil.1
  wrap_mid = soil.2
  wrap_light = soil.3
  ink = ink.base
}

frame "f1" {
  // Ready: Coiled posture, left arm slightly drawn up and braced
  rect (7,12) (10,22) color=ink
  // Deltoid & bicep (12-14)
  rect (8,12) (10,14) color=orc_mid
  pixel (8,12) color=orc_light
  pixel (8,13) color=orc_light
  pixel (9,12) color=orc_light
  pixel (10,14) color=orc_dark
  // Forearm flexed (15-17)
  rect (7,15) (10,17) color=orc_mid
  pixel (7,15) color=orc_light
  pixel (7,16) color=orc_light
  pixel (10,16) color=orc_dark
  pixel (10,17) color=orc_dark
  // Bracer wrap (18-19)
  rect (7,18) (10,19) color=wrap_mid
  line (7,18) (10,18) color=wrap_light
  line (7,19) (10,19) color=wrap_dark
  // Clenched fist (20-22)
  rect (7,20) (10,22) color=orc_mid
  pixel (7,20) color=orc_light
  pixel (8,20) color=orc_light
  pixel (9,22) color=orc_dark
  pixel (10,22) color=ink
  // Contour trimming
  erase pixel (7,12)
  erase pixel (7,13)
  erase pixel (10,22)
}

frame "f2" {
  // Drive: Torso twists forward, left arm thrusts back/downward for balance
  rect (7,13) (10,23) color=ink
  // Shoulder (13-15)
  rect (8,13) (10,15) color=orc_mid
  pixel (8,13) color=orc_light
  pixel (9,13) color=orc_light
  pixel (10,15) color=orc_dark
  // Extended upper forearm (16-18)
  rect (7,16) (10,18) color=orc_mid
  pixel (7,16) color=orc_light
  pixel (8,17) color=orc_light
  pixel (10,17) color=orc_dark
  pixel (10,18) color=orc_dark
  // Bracer wrap (19-20)
  rect (7,19) (10,20) color=wrap_mid
  line (7,19) (10,19) color=wrap_light
  line (7,20) (10,20) color=wrap_dark
  // Knuckles trailing back (21-23)
  rect (7,21) (10,23) color=orc_mid
  pixel (7,21) color=orc_light
  pixel (8,21) color=orc_light
  pixel (9,23) color=orc_dark
  // Clean silhouette
  erase pixel (7,13)
  erase pixel (7,14)
  erase pixel (10,23)
}

frame "f3" {
  // Follow-through: Left arm fully pulled behind, taut muscles
  rect (7,14) (10,23) color=ink
  // Shoulder angled back (14-16)
  rect (8,14) (10,16) color=orc_mid
  pixel (8,14) color=orc_light
  pixel (9,14) color=orc_light
  pixel (10,16) color=orc_dark
  // Forearm (17-19)
  rect (7,17) (10,19) color=orc_mid
  pixel (7,17) color=orc_light
  pixel (8,18) color=orc_light
  pixel (10,18) color=orc_dark
  pixel (10,19) color=orc_dark
  // Bracer wrap (20-21)
  rect (7,20) (10,21) color=wrap_mid
  line (7,20) (10,20) color=wrap_light
  line (7,21) (10,21) color=wrap_dark
  // Fist (22-23)
  rect (7,22) (10,23) color=orc_mid
  pixel (7,22) color=orc_light
  pixel (8,22) color=orc_light
  pixel (9,23) color=orc_dark
  // Silhouette trim
  erase pixel (7,14)
  erase pixel (7,15)
  erase pixel (10,23)
}

frame "f4" {
  // Recover: Returning to balanced ready stance
  rect (7,12) (10,23) color=ink
  // Upper arm / bicep (12-14)
  rect (8,12) (10,14) color=orc_mid
  pixel (8,12) color=orc_light
  pixel (8,13) color=orc_light
  pixel (9,12) color=orc_light
  pixel (10,14) color=orc_dark
  // Forearm (15-18)
  rect (7,15) (10,18) color=orc_mid
  pixel (7,15) color=orc_light
  pixel (7,16) color=orc_light
  pixel (8,16) color=orc_light
  pixel (10,17) color=orc_dark
  pixel (10,18) color=orc_dark
  // Wrist wrap (18-20)
  rect (7,18) (10,20) color=wrap_mid
  line (7,18) (10,18) color=wrap_light
  line (7,20) (10,20) color=wrap_dark
  pixel (8,19) color=wrap_light
  // Hand (21-23)
  rect (7,21) (10,23) color=orc_mid
  pixel (7,21) color=orc_light
  pixel (8,21) color=orc_light
  pixel (7,22) color=orc_light
  pixel (9,22) color=orc_dark
  pixel (10,22) color=ink
  pixel (8,23) color=orc_dark
  pixel (9,23) color=orc_dark
  // Trim
  erase pixel (7,12)
  erase pixel (7,13)
  erase pixel (7,14)
  erase pixel (10,23)
}
