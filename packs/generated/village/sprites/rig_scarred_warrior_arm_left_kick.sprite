frame "f2" {
  // Counterbalance: arm swings back and slightly outward
  // Shoulder pulled back slightly
  rect (6,13) (9,15) color=ink.base
  rect (7,13) (9,14) color=iron.2
  pixel (7,13) color=iron.3
  pixel (6,14) color=iron.1

  // Upper arm flared back
  rect (5,16) (8,19) color=ink.base
  rect (6,16) (7,18) color=soil.2
  pixel (6,17) color=soil.3
  pixel (5,18) color=soil.1

  // Forearm & fist trailing for balance
  rect (4,19) (7,23) color=ink.base
  rect (5,20) (6,22) color=iron.1
  pixel (5,20) color=iron.2
  // Hand extended
  rect (4,22) (6,23) color=sand.2
  pixel (5,22) color=sand.3
  pixel (4,23) color=sand.1
}

frame "f3" {
  // Recovery: arm returning toward default ready stance
  // Shoulder settling
  rect (7,12) (10,14) color=ink.base
  rect (8,12) (10,13) color=iron.2
  pixel (8,12) color=iron.3
  pixel (7,13) color=iron.1

