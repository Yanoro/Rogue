sprite 32x32
kind object
material iron

frame "f1" {
  // Shoulder / upper arm guard
  rect (7,12) (10,14) color=ink.base
  rect (8,12) (10,13) color=iron.2
  pixel (8,12) color=iron.3
  pixel (7,13) color=iron.1

  // Leather sleeve / under-layer
