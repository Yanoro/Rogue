  rect (8,15) (9,17) color=soil.2
  pixel (8,16) color=soil.3
  pixel (7,17) color=soil.1

  // Forearm bracer & fist
  rect (7,19) (10,23) color=ink.base
  rect (8,19) (9,21) color=iron.1
  pixel (8,20) color=iron.2
  // Hand / glove
  rect (7,22) (9,23) color=sand.2
  pixel (8,22) color=sand.3
  pixel (7,23) color=sand.1
