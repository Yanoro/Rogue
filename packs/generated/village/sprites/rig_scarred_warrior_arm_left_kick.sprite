  rect (6,19) (9,23) color=ink.base
  rect (7,19) (8,21) color=iron.1
  pixel (7,20) color=iron.2
  // Hand returning to resting guard
  rect (7,22) (9,23) color=sand.2
  pixel (8,22) color=sand.3
  pixel (7,23) color=sand.1
