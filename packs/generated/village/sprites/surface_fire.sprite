sprite 32x32
kind object

palette {
  ember = #4a0f07
  dark_red = #8c1d10
  fire_red = #d9381e
  fire_orange = #f0781e
  fire_yellow = #f7c844
  fire_white = #fff5bf
}

// Low glowing embers and smoke base
polygon (6,27) (11,28) (16,29) (22,28) (26,27) (20,30) (11,30) color=ember

// Outer flame body silhouette
polygon (6,26) (8,20) (9,16) (12,19) (14,13) (16,8) (18,13) (21,11) (22,17) (25,18) (26,26) (16,28) color=dark_red

