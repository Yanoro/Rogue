sprite 32x32
kind object
material iron

palette {
  tsuba = #c89b3c
  tsuba_dark = #835f1b
  blood_glow = #a81c24
  blood_bright = #de343b
  cord = #1e1d21
  cord_dark = #100f12
}

frame "f1" {
  // Tsuka (hilt) gripped in right hand (y: 21-26, slight forward tilt)
  line (24,21) (25,26) color=ink.base
  line (23,21) (24,26) color=cord
  pixel (24,22) color=cord_dark
  pixel (24,24) color=cord_dark
  pixel (25,26) color=iron.1
  pixel (24,26) color=iron.2

  // Tsuba (guard)
  rect (21,19) (24,20) color=tsuba_dark
  pixel (22,19) color=tsuba
  pixel (23,19) color=tsuba
  pixel (21,20) color=ink.base
  pixel (24,20) color=ink.base

  // Habaki (collar)
  pixel (22,18) color=tsuba
  pixel (23,18) color=tsuba_dark

  // Blade spine
  line (22,17) (22,14) color=iron.1
  line (22,14) (23,9) color=iron.1
  line (23,9) (25,5) color=iron.1
  pixel (26,4) color=ink.base

  // Blade body
  line (21,17) (21,14) color=iron.3
  line (21,14) (22,9) color=iron.3
  line (22,9) (24,5) color=iron.4
  pixel (25,4) color=iron.4
  pixel (25,3) color=iron.4

  // Blade highlights
  pixel (21,15) color=iron.4
  pixel (22,11) color=iron.4
  pixel (23,7) color=iron.4

  // Blood-tempered cutting edge
  line (20,17) (20,15) color=blood_glow
  line (20,14) (21,10) color=blood_glow
  line (21,9) (23,5) color=blood_glow
  pixel (24,4) color=blood_bright
  pixel (24,3) color=blood_bright

  // Edge gleams
  pixel (20,16) color=blood_bright
  pixel (21,12) color=blood_bright
  pixel (22,8) color=blood_bright

  // Kissaki (tip)
  pixel (25,3) color=iron.4
  pixel (26,3) color=ink.base
}

