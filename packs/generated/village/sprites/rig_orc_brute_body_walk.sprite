sprite 32x32
kind object
material grass

palette {
  orc_dark = grass.0
  orc_mid = grass.1
  orc_light = grass.2
  leather_dark = soil.0
  leather = soil.1
  leather_light = soil.2
  buckle = iron.3
  scar = soil.2
}

frame "f1" {
  // Base muscular torso silhouette (dipped 1px for contact pose)
  rect (10,13) (22,22) color=orc_mid
  rect (11,12) (21,22) color=orc_mid

  // Shading / bulk contours
  line (10,13) (10,22) color=orc_dark
  line (22,13) (22,22) color=orc_dark
  rect (10,20) (22,22) color=orc_dark
  rect (11,13) (15,17) color=orc_light
  rect (17,13) (21,17) color=orc_light
  line (16,14) (16,19) color=orc_dark
  line (12,18) (20,18) color=orc_dark

  // Crossed brown leather straps across chest
  line (11,13) (21,21) color=leather
  line (12,13) (21,20) color=leather_light
  line (21,13) (11,21) color=leather
  line (20,13) (11,20) color=leather_dark

  // Central harness ring / buckle
  pixel (16,17) color=buckle
  pixel (15,17) color=leather_dark
  pixel (17,17) color=leather_dark

  // Scar across left chest/ribs
  pixel (13,15) color=scar
  pixel (14,16) color=scar

  // Sturdy belt at waistline
  rect (10,21) (22,23) color=leather_dark
  rect (11,22) (21,22) color=leather
  pixel (16,22) color=buckle
  pixel (15,22) color=iron.1
  pixel (17,22) color=iron.1

  // Outlines
  line (11,12) (21,12) color=ink.base
  line (9,13) (9,23) color=ink.base
  line (23,13) (23,23) color=ink.base
  line (10,23) (22,23) color=ink.base
}

