sprite 32x32
kind object
material grass

palette {
  orc_dark = #2d451b
  orc_mid = #456b23
  orc_light = #618f33
  wrap_dark = soil.1
  wrap_mid = soil.2
  wrap_light = soil.3
  ink = ink.base
}

frame "f1" {
  // f1: Wind up - arm tightens into a guard, elbow bent and pulled slightly up
  rect (7,12) (10,22) color=ink

  // Shoulder and bicep (12-14)
  rect (8,12) (10,14) color=orc_mid
  pixel (8,12) color=orc_light
  pixel (8,13) color=orc_light
  pixel (9,12) color=orc_light
  pixel (10,13) color=orc_dark
  pixel (10,14) color=orc_dark

  // Forearm drawn taut (15-17)
  rect (7,15) (10,17) color=orc_mid
  pixel (7,15) color=orc_light
  pixel (8,15) color=orc_light
  pixel (7,16) color=orc_light
  pixel (10,16) color=orc_dark
  pixel (10,17) color=orc_dark

  // Wrist wrap tightened high (18-19)
  rect (7,18) (10,19) color=wrap_mid
  line (7,18) (10,18) color=wrap_light
  pixel (8,19) color=wrap_light
  pixel (10,19) color=wrap_dark

  // Raised fist held firm (20-22)
  rect (7,20) (10,22) color=orc_mid
  pixel (7,20) color=orc_light
  pixel (8,20) color=orc_light
  pixel (7,21) color=orc_light
  pixel (9,21) color=orc_dark
  pixel (10,21) color=ink
  pixel (8,22) color=orc_dark
  pixel (9,22) color=orc_dark

  // Silhouette refinement
  erase pixel (7,12)
  erase pixel (7,13)
  erase pixel (10,22)
}

frame "f2" {
  // f2: Extend - arm flares back and down to counterbalance kick
  rect (7,13) (10,23) color=ink

  // Shoulder stretched back (13-15)
  rect (8,13) (10,15) color=orc_mid
  pixel (8,13) color=orc_light
  pixel (9,13) color=orc_light
  pixel (8,14) color=orc_light
  pixel (10,14) color=orc_dark
  pixel (10,15) color=orc_dark

  // Forearm flexed lower (16-18)
  rect (7,16) (10,18) color=orc_mid
  pixel (7,16) color=orc_light
  pixel (8,16) color=orc_light
  pixel (7,17) color=orc_light
  pixel (10,17) color=orc_dark
  pixel (10,18) color=orc_dark

  // Wrist wrap shifted down (19-20)
  rect (7,19) (10,20) color=wrap_mid
  line (7,19) (10,19) color=wrap_light
  line (7,20) (10,20) color=wrap_dark
  pixel (8,20) color=wrap_light

  // Clenched fist extended down/back (21-23)
  rect (7,21) (10,23) color=orc_mid
  pixel (7,21) color=orc_light
  pixel (8,21) color=orc_light
  pixel (7,22) color=orc_light
  pixel (9,22) color=orc_dark
  pixel (10,22) color=ink
  pixel (8,23) color=orc_dark
  pixel (9,23) color=orc_dark

  // Silhouette refinement
  erase pixel (7,13)
  erase pixel (7,14)
  erase pixel (10,23)
}

frame "f3" {
  // f3: Recover - arm returns towards neutral stance
  rect (7,12) (10,23) color=ink

  // Bicep / shoulder returning (12-14)
  rect (8,12) (10,14) color=orc_mid
  pixel (8,12) color=orc_light
  pixel (8,13) color=orc_light
  pixel (9,12) color=orc_light
  pixel (10,14) color=orc_dark

  // Forearm settling (15-18)
  rect (7,15) (10,18) color=orc_mid
  pixel (7,15) color=orc_light
  pixel (7,16) color=orc_light
  pixel (8,16) color=orc_light
  pixel (10,17) color=orc_dark
  pixel (10,18) color=orc_dark

  // Wrist wrap (18-20)
  rect (7,18) (10,20) color=wrap_mid
  line (7,18) (10,18) color=wrap_light
  line (7,20) (10,20) color=wrap_dark
  pixel (8,19) color=wrap_light

  // Fist in rest position (21-23)
  rect (7,21) (10,23) color=orc_mid
  pixel (7,21) color=orc_light
  pixel (8,21) color=orc_light
  pixel (7,22) color=orc_light
  pixel (9,22) color=orc_dark
  pixel (10,22) color=ink
  pixel (8,23) color=orc_dark
  pixel (9,23) color=orc_dark

  // Silhouette refinement
  erase pixel (7,12)
  erase pixel (7,13)
  erase pixel (7,14)
  erase pixel (10,23)
}
