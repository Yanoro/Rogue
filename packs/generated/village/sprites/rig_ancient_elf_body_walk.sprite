sprite 32x32
kind object
material grass

frame "f1" {
  // Contact: lowest position (y: 12 to 23)
  // Outline & Silhouette
  rect (10,12) (22,23) color=ink.base
  // Base tunic body
  rect (11,13) (21,22) color=grass.2
  // Torso depth & shading
  line (11,13) (11,22) color=grass.3
  line (21,13) (21,22) color=grass.1
  line (11,22) (21,22) color=grass.0
  // Neck collar trim / opening
  pixel (15,12) color=grass.1
  pixel (16,12) color=grass.1
  pixel (15,13) color=grass.0
  pixel (16,13) color=grass.0
  // Belt at waist (y: 18)
  line (11,18) (21,18) color=wood.1
  pixel (15,18) color=wood.3
  pixel (16,18) color=wood.4
  pixel (16,19) color=wood.2
  // Tunic skirt split / fold
  line (16,19) (16,22) color=grass.1
  pixel (17,20) color=grass.0
}

frame "f2" {
  // Passing: body rises 1px (y: 11 to 22), slight tilt/sway
  // Outline & Silhouette
  rect (10,11) (22,22) color=ink.base
  // Base tunic body
  rect (11,12) (21,21) color=grass.2
  // Torso depth & shading
  line (11,12) (11,21) color=grass.3
  line (21,12) (21,21) color=grass.1
  line (11,21) (21,21) color=grass.0
  // Neck collar trim / opening
  pixel (15,11) color=grass.1
  pixel (16,11) color=grass.1
  pixel (15,12) color=grass.0
  pixel (16,12) color=grass.0
  // Belt at waist (y: 17)
  line (11,17) (21,17) color=wood.1
  pixel (15,17) color=wood.3
  pixel (16,17) color=wood.4
  pixel (15,18) color=wood.2
  // Tunic skirt fold slightly shifting right
  line (15,18) (15,21) color=grass.1
  pixel (16,19) color=grass.0
}

frame "f3" {
  // Contact: lowest position (y: 12 to 23), symmetric stride
  // Outline & Silhouette
  rect (10,12) (22,23) color=ink.base
