sprite 32x32
kind object
material grass

palette {
  orc_dark = grass.0
  orc_mid = grass.1
  orc_light = grass.2
  leather_dark = soil.0
  leather = soil.1
  leather_light = soil.2
  buckle = iron.3
  scar = soil.2
}

frame "f1" {
  // Coiled back: right shoulder lifted slightly, torso arched back
  rect (10,12) (22,21) color=orc_mid
  rect (11,11) (21,21) color=orc_mid
  pixel (22,11) color=orc_mid

  // Shading & musculature
  line (10,12) (10,21) color=orc_dark
  line (22,12) (22,21) color=orc_dark
  rect (10,19) (22,20) color=orc_dark
  rect (11,12) (15,15) color=orc_light
  rect (17,11) (21,15) color=orc_light
  line (16,12) (16,18) color=orc_dark
  line (12,16) (20,16) color=orc_dark

  // Straps tensioned towards raised right shoulder
  line (11,13) (22,19) color=leather
  line (12,13) (22,18) color=leather_light
  line (21,11) (11,19) color=leather
  line (20,11) (11,18) color=leather_dark

  // Central ring
  pixel (16,15) color=buckle
  pixel (15,15) color=leather_dark
  pixel (17,15) color=leather_dark

  // Scarring
  pixel (13,13) color=scar
  pixel (14,14) color=scar

  // Belt angled slightly
  rect (10,20) (22,22) color=leather_dark
  rect (11,21) (21,21) color=leather
  pixel (16,21) color=buckle
  pixel (15,21) color=iron.1
  pixel (17,21) color=iron.1

  // Outlines
  line (11,10) (22,10) color=ink.base
  line (9,12) (9,22) color=ink.base
  line (23,11) (23,22) color=ink.base
  line (10,22) (22,22) color=ink.base
}

frame "f2" {
  // Drive: torso twists forward, compressed slightly downward
  rect (10,13) (22,22) color=orc_mid
  rect (11,12) (21,22) color=orc_mid

  // Muscular shading shifted forward
  line (10,13) (10,21) color=orc_dark
  line (22,13) (22,21) color=orc_dark
  rect (10,19) (22,20) color=orc_dark
  rect (11,13) (15,17) color=orc_mid
  rect (16,13) (20,17) color=orc_light
  line (15,14) (15,19) color=orc_dark
  line (11,18) (20,18) color=orc_dark

  // Harness shifted with forward torque
  line (10,13) (20,21) color=leather
  line (11,13) (20,20) color=leather_light
  line (21,13) (11,21) color=leather
  line (20,13) (11,20) color=leather_dark

  // Buckle shifted left
  pixel (15,17) color=buckle
  pixel (14,17) color=leather_dark
  pixel (16,17) color=leather_dark

  // Scarring
  pixel (12,15) color=scar
  pixel (13,16) color=scar

  // Belt driven low
  rect (10,21) (22,22) color=leather_dark
  line (11,21) (21,21) color=leather
  pixel (15,21) color=buckle
  pixel (14,21) color=iron.1
  pixel (16,21) color=iron.1

  // Outlines
  line (11,11) (21,11) color=ink.base
  line (9,13) (9,22) color=ink.base
  line (23,13) (23,22) color=ink.base
  line (10,23) (22,23) color=ink.base
}

frame "f3" {
  // Follow through: heavy torso twist leftward, dipping low
  rect (10,13) (21,22) color=orc_mid
  rect (11,12) (20,22) color=orc_mid
  pixel (9,14) color=orc_mid

  // Muscular compression
  line (9,14) (9,21) color=orc_dark
  line (21,13) (21,21) color=orc_dark
  rect (10,19) (21,20) color=orc_dark
  rect (11,13) (14,17) color=orc_dark
  rect (15,13) (19,17) color=orc_light
  line (14,14) (14,19) color=orc_dark
  line (11,17) (19,17) color=orc_dark

  // Slanted harness
  line (10,14) (19,21) color=leather
  line (11,14) (19,20) color=leather_light
  line (20,13) (10,21) color=leather
  line (19,13) (10,20) color=leather_dark

  // Buckle pulled left
  pixel (14,17) color=buckle
  pixel (13,17) color=leather_dark
  pixel (15,17) color=leather_dark

  // Scarring
  pixel (11,15) color=scar
  pixel (12,16) color=scar

  // Belt rotated
  rect (10,21) (21,22) color=leather_dark
  line (11,21) (20,21) color=leather
  pixel (14,21) color=buckle
  pixel (13,21) color=iron.1
  pixel (15,21) color=iron.1

  // Outlines
  line (11,11) (20,11) color=ink.base
  line (8,14) (8,22) color=ink.base
  line (22,12) (22,22) color=ink.base
  line (9,23) (21,23) color=ink.base
}

frame "f4" {
  // Recover: returning to neutral stance, slightly settling
  rect (10,12) (22,21) color=orc_mid
  rect (11,11) (21,21) color=orc_mid

  // Shading / bulk contours
  line (10,12) (10,21) color=orc_dark
  line (22,12) (22,21) color=orc_dark
  rect (10,19) (22,21) color=orc_dark
  rect (11,12) (15,16) color=orc_light
  rect (17,12) (21,16) color=orc_light
  line (16,13) (16,18) color=orc_dark
  line (12,17) (20,17) color=orc_dark

  // Crossed harness
  line (11,12) (21,20) color=leather
  line (12,12) (21,19) color=leather_light
  line (21,12) (11,20) color=leather
  line (20,12) (11,19) color=leather_dark

  // Central ring
  pixel (16,16) color=buckle
  pixel (15,16) color=leather_dark
  pixel (17,16) color=leather_dark

  // Scar
  pixel (13,14) color=scar
  pixel (14,15) color=scar

  // Belt
  rect (10,20) (22,22) color=leather_dark
  rect (11,21) (21,21) color=leather
  pixel (16,21) color=buckle
  pixel (15,21) color=iron.1
  pixel (17,21) color=iron.1

  // Outlines
  line (11,11) (21,11) color=ink.base
  line (9,12) (9,22) color=ink.base
  line (23,12) (23,22) color=ink.base
  line (10,22) (22,22) color=ink.base
}
