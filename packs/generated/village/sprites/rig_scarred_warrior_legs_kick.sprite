  pixel (13,27) color=wood.2
  line (17,19) (20,19) color=soil.3
  line (21,19) (23,19) color=wood.2
}

frame "f3" {
  // Left leg (planted, bearing full weight)
  rect (12,21) (15,26) color=soil.2
  rect (12,26) (16,30) color=wood.1
  line (11,31) (16,31) color=wood.0
  line (11,21) (11,31) color=ink.base
  line (16,21) (16,31) color=ink.base
