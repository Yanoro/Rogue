sprite 32x32
kind object
material iron

palette {
  dark = ink.base
  fur_dark = iron.1
  fur_mid = iron.2
  fur_lit = stone.2
  fur_light = stone.3
  eye = sand.3
  pupil = ink.base
  nose = ink.base
}

// Silhouette / Under-outline
polygon (3,18) (7,14) (11,14) (13,11) (17,10) (22,12) (26,16) (28,21) (26,23) (23,20) (23,27) (21,28) (19,25) (19,21) (15,21) (15,27) (13,28) (11,24) (11,20) (8,21) (3,18) color=dark

// Body mass fill
polygon (4,18) (7,15) (11,15) (13,12) (17,11) (22,13) (25,17) (27,21) (25,22) (22,19) (22,26) (20,27) (18,21) (15,20) (14,26) (12,27) (11,22) (8,19) (4,18) color=fur_mid

// Back legs (far side shadow)
line (17,21) (17,26) color=fur_dark
line (24,20) (25,25) color=fur_dark

// Chest & shoulder volume
polygon (9,16) (14,13) (17,12) (16,19) (10,20) color=fur_mid
polygon (11,14) (16,12) (15,18) color=fur_lit

// Back & flank shading
line (15,11) (22,13) color=fur_lit
line (16,12) (21,14) color=fur_lit
polygon (14,18) (21,17) (23,19) (18,20) color=fur_dark

// Low stalking neck and head
polygon (4,18) (7,15) (11,14) (12,18) (8,20) (4,19) color=fur_mid
polygon (6,15) (10,14) (11,17) (8,18) color=fur_lit

// Ears
polygon (10,14) (12,10) (13,13) color=dark
polygon (11,13) (12,11) (12,13) color=fur_dark
polygon (13,13) (14,10) (15,13) color=dark
polygon (14,12) (14,11) (15,12) color=fur_lit

// Snout and muzzle
polygon (3,18) (6,16) (7,19) (4,20) color=fur_dark
pixel (3,18) color=nose
pixel (4,18) color=fur_mid
pixel (4,19) color=dark

// Unblinking eye
pixel (7,16) color=eye
pixel (8,16) color=pupil

// Bushy trailing tail
polygon (23,17) (27,19) (29,23) (27,24) (24,21) color=fur_mid
line (24,18) (28,21) color=fur_lit
line (25,22) (28,24) color=fur_dark
pixel (29,23) color=dark

// Front near leg
polygon (9,19) (12,19) (11,26) (10,27) (8,27) color=fur_mid
line (9,20) (9,26) color=fur_lit
pixel (8,27) color=dark
pixel (9,27) color=dark

// Rear near leg
polygon (20,18) (23,18) (22,23) (21,27) (19,27) color=fur_mid
line (20,19) (20,26) color=fur_lit
pixel (19,27) color=dark
pixel (20,27) color=dark

// Fur texture / ruff scatter inside the body
scatter color=fur_light,fur_dark density=0.15 seed=41 cluster=1 inside
