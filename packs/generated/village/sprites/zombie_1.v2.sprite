sprite 96x96
kind object
material iron
wrap off

palette {
  bg = #00000000
  outline = #0d0b0a
  skin_dark = #2a231d
  skin_mid = #5a4938
  skin_lit = #cbb89a
  cloth_base = #1b1714
  cloth_mid = #3b3128
  cloth_light = #5a4938
  iron_light = #6b6f73
  iron_dark = #43474a
  rust_red = #7a3f2a
  eye_ember = #d0783a
  glow_high = #e6c48a
}

// === Silhouettes and Base Shapes (Dark Outline / Mass) ===
// Torso & Hump outline
circle (48,40) radius=21 color=outline
rect (34,36) (60,66) color=outline
// Hunched Head outline
circle (40,24) radius=12 color=outline
rect (34,22) (46,34) color=outline

// Right arm (dragging down)
line (30,36) (22,54) color=outline
circle (22,55) radius=7 color=outline
line (22,55) (17,76) color=outline
circle (16,77) radius=6 color=outline

// Left arm (twisted forward/bent)
line (64,38) (73,50) color=outline
circle (74,51) radius=6 color=outline
line (74,52) (71,68) color=outline
circle (70,70) radius=5 color=outline

// Legs outline
rect (33,62) (45,86) color=outline
rect (51,62) (63,86) color=outline
circle (36,88) radius=6 color=outline
circle (56,88) radius=6 color=outline

// === Base Flesh / Inner Silhouette ===
circle (48,40) radius=19 color=skin_dark
rect (36,38) (58,64) color=skin_dark
circle (40,24) radius=10 color=skin_dark
rect (35,24) (44,32) color=skin_dark

// Legs fill
rect (35,64) (43,84) color=skin_dark
rect (53,64) (61,84) color=skin_dark
circle (36,87) radius=4 color=skin_dark
circle (56,87) radius=4 color=skin_dark

// Limbs fill
circle (22,55) radius=5 color=skin_dark
circle (16,77) radius=4 color=skin_dark
line (29,38) (22,54) color=skin_mid
line (22,55) (17,76) color=skin_mid

circle (74,51) radius=4 color=skin_dark
circle (70,70) radius=3 color=skin_dark
line (63,40) (73,50) color=skin_mid
line (73,51) (70,68) color=skin_mid

// === Necrotic Flesh Tones & Bone Highlights ===
// Skull & Hunched Visage
polygon (35,17) (44,16) (47,22) (42,28) (34,25) color=skin_mid
polygon (36,18) (42,17) (45,21) (39,24) color=skin_lit
pixel (38,20) color=glow_high
pixel (42,19) color=glow_high

// Sunken eye sockets & rotting features
rect (34,22) (37,25) color=outline
rect (41,21) (44,24) color=outline
pixel (35,23) color=eye_ember
pixel (42,22) color=rust_red

// Exposed jaw / teeth
line (34,29) (41,28) color=outline
pixel (36,29) color=skin_lit
pixel (38,28) color=skin_lit
pixel (40,28) color=skin_lit
line (35,31) (41,31) color=outline

// Rotting Neck & Collarbone
line (44,28) (50,33) color=skin_lit
line (43,30) (49,35) color=rust_red

// === Shrouded Garments & Ragged Cloth ===
polygon (36,44) (60,42) (58,68) (50,76) (43,69) (34,74) (32,48) color=cloth_base
polygon (37,45) (58,43) (56,66) (49,72) (44,67) (36,70) (34,48) color=cloth_mid

// Fold shadows and fraying edges
line (44,46) (42,67) color=cloth_base
line (51,45) (49,69) color=cloth_base
line (39,52) (45,63) color=cloth_light
line (47,50) (53,62) color=cloth_light

// Jagged cloth shreds
polygon (33,72) (35,78) (37,70) color=cloth_base
polygon (41,68) (44,80) (47,68) color=cloth_base
polygon (48,70) (51,79) (54,67) color=cloth_base

// === Iron Remains / Rusty Manacles & Plates ===
// Iron Collar / Gorget remnant
polygon (41,33) (54,34) (52,40) (39,38) color=iron_dark
polygon (43,34) (52,35) (51,38) (41,37) color=iron_light
line (45,36) (48,36) color=rust_red

// Broken chain link on neck
pixel (54,37) color=iron_dark
pixel (55,39) color=iron_light
pixel (56,42) color=rust_red
pixel (56,44) color=iron_dark

// Right wrist manacle
circle (18,72) radius=4 color=iron_dark
circle (18,72) radius=3 color=iron_light
line (17,70) (19,74) color=rust_red
pixel (18,76) color=iron_dark
pixel (17,78) color=iron_light

// Dragging leg wound / exposed bone
line (36,73) (37,77) color=outline
pixel (37,74) color=skin_lit
pixel (37,75) color=rust_red
pixel (38,76) color=outline

line (57,75) (58,79) color=rust_red
pixel (58,76) color=skin_mid

// === Claws & Exposed Feet ===
// Left hand grasping
pixel (69,72) color=skin_lit
pixel (71,73) color=skin_lit
pixel (70,74) color=glow_high
pixel (72,74) color=outline

// Right hand dragged
pixel (15,80) color=skin_lit
pixel (17,81) color=glow_high
pixel (19,80) color=skin_lit
pixel (16,82) color=outline
pixel (18,82) color=outline

// Feet clawed to the ground
rect (32,87) (39,89) color=skin_dark
line (32,89) (39,89) color=outline
pixel (32,88) color=skin_lit
pixel (34,88) color=skin_lit

rect (54,87) (61,89) color=skin_dark
line (54,89) (61,89) color=outline
pixel (59,88) color=skin_lit
pixel (61,88) color=skin_lit

// === Weathering & Rot Scatter ===
scatter color=rust_red,skin_dark density=0.18 seed=382 cluster=2 inside
scatter color=skin_lit,glow_high density=0.04 seed=911 cluster=1 inside
