sprite 32x32
kind object
material grass

frame "f1" {
  // Shoulder / upper bicep anchor (shifted forward & slightly low due to bob)
  rect (22,13) (25,16) color=grass.1
  rect (22,13) (24,15) color=grass.2
  pixel (23,13) color=grass.3
  pixel (22,13) color=ink.base
  pixel (25,13) color=ink.base

  // Forearm flexed forward/inward
  rect (22,17) (25,19) color=grass.2
  pixel (22,18) color=grass.3
  pixel (25,18) color=grass.0

  // Thick wrist wrap
  rect (22,20) (25,21) color=wood.1
  line (22,20) (25,20) color=wood.2
  pixel (22,21) color=wood.0
  pixel (25,21) color=wood.0

  // Open grip hand
  rect (22,22) (25,23) color=grass.1
  pixel (23,22) color=grass.2
  pixel (24,22) color=grass.2
  pixel (23,23) color=ink.base
  pixel (25,22) color=grass.0
}

