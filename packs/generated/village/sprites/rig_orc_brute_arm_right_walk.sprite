  pixel (23,21) color=grass.2
  pixel (24,22) color=grass.2
  pixel (23,23) color=ink.base
  pixel (25,21) color=grass.0
  pixel (25,22) color=grass.0
}

frame "f3" {
  // Shoulder / upper bicep anchor (swung backward, body at low point)
