sprite 32x32
kind object
material stone

palette {
  out = #1A1210
  skin_base = #F2C79A
  skin_hi = #FFE0B8
  skin_sh = #C98B60
  cloth_base = #8C93A8
  cloth_hi = #B0B7CC
  cloth_sh = #5E657A
}

// Outline silhouette for the right arm & gripping hand
rect (22,12) (25,23) color=out

// Sleeve fill (tattered/frayed grey cloth from shoulder to wrist)
rect (23,13) (24,18) color=cloth_base
pixel (22,14) color=cloth_base
pixel (25,14) color=cloth_base

// Sleeve lighting and frayed hem details
pixel (23,13) color=cloth_hi
pixel (23,14) color=cloth_hi
pixel (24,16) color=cloth_sh
pixel (24,17) color=cloth_sh
pixel (25,17) color=cloth_sh
// Fray notches at the cuff
pixel (22,18) color=out
pixel (23,18) color=cloth_sh
pixel (24,18) color=cloth_base

// Bare gripping hand (wrist to knuckles/fingers wrapped around weapon anchor at 24,22)
rect (23,19) (24,22) color=skin_base
pixel (23,19) color=skin_hi
pixel (23,20) color=skin_hi
pixel (24,20) color=skin_base
pixel (24,21) color=skin_sh
pixel (23,22) color=skin_sh
pixel (24,22) color=skin_base

// Grip finger delineation & inner shadow
pixel (23,21) color=skin_hi
pixel (22,21) color=out
pixel (25,21) color=out
pixel (25,22) color=out

// Trim corners to keep crisp rounded chibi shape
erase pixel (22,12)
erase pixel (25,12)
erase pixel (22,13)
erase pixel (25,13)
erase pixel (22,23)
erase pixel (25,23)
