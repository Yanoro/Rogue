sprite 32x32
kind object
material stone

palette {
  out = #1A1210
  skin_base = #F2C79A
  skin_hi = #FFE0B8
  skin_sh = #C98B60
  cloth_base = #8C93A8
  cloth_hi = #B0B7CC
  cloth_sh = #5E657A
}

frame "f1" {
  // Outline silhouette for raised right arm & gripping hand
  rect (22,11) (25,22) color=out

  // Sleeve fill (lifted 1px upward for inhaled chest/shoulder)
  rect (23,12) (24,17) color=cloth_base
  pixel (22,13) color=cloth_base
  pixel (25,13) color=cloth_base

  // Sleeve lighting and frayed details
  pixel (23,12) color=cloth_hi
  pixel (23,13) color=cloth_hi
  pixel (24,15) color=cloth_sh
  pixel (24,16) color=cloth_sh
  pixel (25,16) color=cloth_sh
  // Frayed cuff notches
  pixel (22,17) color=out
  pixel (23,17) color=cloth_sh
  pixel (24,17) color=cloth_base

  // Bare gripping hand
  rect (23,18) (24,21) color=skin_base
  pixel (23,18) color=skin_hi
  pixel (23,19) color=skin_hi
  pixel (24,19) color=skin_base
  pixel (24,20) color=skin_sh
  pixel (23,21) color=skin_sh
  pixel (24,21) color=skin_base

  // Grip finger delineation & inner shadow
  pixel (23,20) color=skin_hi
  pixel (22,20) color=out
  pixel (25,20) color=out
  pixel (25,21) color=out

  // Rounded corners
  erase pixel (22,11)
  erase pixel (25,11)
  erase pixel (22,12)
  erase pixel (25,12)
  erase pixel (22,22)
  erase pixel (25,22)
}

frame "f2" {
  // Outline silhouette for settled right arm & gripping hand
  rect (22,12) (25,23) color=out

  // Sleeve fill (settled position)
  rect (23,13) (24,18) color=cloth_base
  pixel (22,14) color=cloth_base
  pixel (25,14) color=cloth_base

  // Sleeve lighting and frayed details
  pixel (23,13) color=cloth_hi
  pixel (23,14) color=cloth_hi
  pixel (24,16) color=cloth_sh
  pixel (24,17) color=cloth_sh
  pixel (25,17) color=cloth_sh
  // Frayed cuff notches
  pixel (22,18) color=out
  pixel (23,18) color=cloth_sh
  pixel (24,18) color=cloth_base

  // Bare gripping hand
  rect (23,19) (24,22) color=skin_base
  pixel (23,19) color=skin_hi
  pixel (23,20) color=skin_hi
  pixel (24,20) color=skin_base
  pixel (24,21) color=skin_sh
  pixel (23,22) color=skin_sh
  pixel (24,22) color=skin_base

  // Grip finger delineation & inner shadow
  pixel (23,21) color=skin_hi
  pixel (22,21) color=out
  pixel (25,21) color=out
  pixel (25,22) color=out

  // Rounded corners
  erase pixel (22,12)
  erase pixel (25,12)
  erase pixel (22,13)
  erase pixel (25,13)
  erase pixel (22,23)
  erase pixel (25,23)
}
