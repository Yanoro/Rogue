sprite 32x32
kind object
material grass

palette {
  out = ink.base
  skin_dark = grass.0
  skin_mid = grass.1
  skin_light = grass.2
  hair = soil.0
  shirt_dark = iron.1
  shirt_mid = iron.2
  shirt_light = iron.3
  pants_dark = soil.1
  pants_mid = soil.2
  eye_glow = sand.3
  blood = wood.1
}

// Outline silhouette
rect (10,3) (21,13) color=out
rect (8,14) (23,22) color=out
rect (10,23) (21,30) color=out
rect (7,15) (9,25) color=out
rect (22,15) (24,25) color=out

// Head base & face
rect (11,4) (20,12) color=skin_mid
rect (11,4) (20,6) color=hair
pixel (10,5) color=hair
pixel (12,7) color=hair
pixel (17,7) color=hair

// Shading on face (light from top-left)
rect (11,7) (13,12) color=skin_light
rect (18,8) (20,12) color=skin_dark
pixel (11,12) color=skin_mid

// Sunken eye sockets & glowing eyes
rect (12,8) (14,10) color=out
rect (17,8) (19,10) color=out
pixel (13,9) color=eye_glow
pixel (18,9) color=eye_glow

// Mouth / jaw rot
line (13,11) (18,11) color=out
pixel (15,11) color=blood
pixel (14,12) color=out

// Tattered Shirt / Torso
rect (10,14) (21,21) color=shirt_mid
rect (10,14) (13,20) color=shirt_light
rect (18,14) (21,21) color=shirt_dark

// Exposed chest wound / rot
pixel (15,16) color=skin_dark
pixel (16,16) color=blood
pixel (16,17) color=skin_dark

// Tattered shirt hem
pixel (11,21) color=pants_mid
pixel (14,21) color=pants_mid
pixel (17,21) color=pants_mid
pixel (20,21) color=pants_mid

// Arms (hanging forward / shambling)
rect (8,15) (9,23) color=shirt_light
rect (8,23) (9,25) color=skin_mid
rect (22,15) (23,23) color=shirt_dark
rect (22,23) (23,25) color=skin_dark

// Trousers
rect (11,22) (15,28) color=pants_mid
rect (16,22) (20,28) color=pants_dark
line (15,22) (16,28) color=out

// Tattered knees / exposed bone or skin
pixel (13,25) color=skin_mid
pixel (18,26) color=skin_dark

// Feet / shoes aligned to canvas bottom
rect (10,29) (14,30) color=iron.0
rect (17,29) (21,30) color=iron.0
pixel (11,29) color=iron.1
pixel (18,29) color=iron.1

// Outward arm details & clean borders
pixel (7,25) color=skin_light
pixel (24,25) color=skin_mid
pixel (7,24) color=out
pixel (24,24) color=out

// Organic surface grime
scatter color=grass.0,soil.0 density=0.04 seed=42 inside
