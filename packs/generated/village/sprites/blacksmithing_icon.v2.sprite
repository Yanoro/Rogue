sprite 32x32
kind object
wrap off

palette {
  out = #1A1210
  light = #FFE0B8
  mid = #F2C79A
  dark = #C98B60
  flame = #F2C79A
}

// Low flames beneath the pot
rect (9,25) (22,28) color=out
polygon (9,28) (11,23) (13,26) (16,21) (19,26) (21,23) (23,28) color=out
polygon (11,27) (12,24) (13,27) color=flame
polygon (15,27) (16,23) (17,27) color=flame
polygon (19,27) (20,24) (21,27) color=flame

// Hearth / fire base line
line (8,28) (23,28) color=out

// Pot silhouette outline
circle (16,18) radius=7 color=out
rect (9,11) (22,14) color=out
rect (7,10) (24,12) color=out

// Handles
pixel (7,14) color=out
pixel (6,15) color=out
pixel (6,16) color=out
pixel (7,17) color=out
pixel (24,14) color=out
pixel (25,15) color=out
pixel (25,16) color=out
pixel (24,17) color=out

// Pot body fill (two-tone interior)
circle (16,18) radius=6 color=dark
circle (15,17) radius=5 color=mid
rect (10,12) (21,15) color=mid

// Rim opening and interior depth
rect (8,11) (23,11) color=out
rect (9,11) (22,11) color=light
line (10,12) (21,12) color=dark

// Steam curl rising above
pixel (15,9) color=out
pixel (15,8) color=light
pixel (14,7) color=light
pixel (14,6) color=light
pixel (15,5) color=light
pixel (16,4) color=light
pixel (17,4) color=light
pixel (18,5) color=light
pixel (18,6) color=out
pixel (17,6) color=light
