sprite 32x32
kind object
material wood

frame "f1" {
  // Left leg forward / right leg back
  // Left trouser & boot (viewer left: x=11..15, y=23..31)
  rect (12,23) (15,26) color=soil.2
  rect (11,26) (15,30) color=wood.2
  line (11,31) (15,31) color=ink.base
  line (12,27) (14,27) color=wood.3
  pixel (12,28) color=wood.4

  // Right trouser & boot (viewer right: trailing slightly, x=17..20, y=23..30)
  rect (17,23) (20,26) color=soil.1
  rect (17,26) (20,29) color=wood.1
  line (17,30) (20,30) color=ink.base

  // Outlines & separation
  line (11,27) (11,30) color=ink.base
  line (15,27) (15,30) color=ink.base
  line (16,23) (16,28) color=ink.base
  line (20,26) (20,29) color=ink.base
}

frame "f2" {
  // Passing: left leg plant, right leg lifting
  // Left trouser & boot (viewer left: plant at y=23..31)
  rect (12,23) (15,26) color=soil.2
  rect (12,27) (15,30) color=wood.2
  line (12,31) (15,31) color=ink.base
  pixel (13,28) color=wood.3

  // Right trouser & boot (viewer right: lifted slightly at y=23..29)
  rect (17,23) (20,25) color=soil.2
  rect (17,26) (20,28) color=wood.2
  line (17,29) (20,29) color=ink.base
  pixel (18,27) color=wood.3

  // Outlines & separation
  line (11,27) (11,30) color=ink.base
  line (16,23) (16,30) color=ink.base
  line (21,26) (21,28) color=ink.base
}

frame "f3" {
  // Right leg forward / left leg back
  // Left trouser & boot (viewer left: trailing, x=12..15, y=23..30)
  rect (12,23) (15,26) color=soil.1
  rect (12,26) (15,29) color=wood.1
  line (12,30) (15,30) color=ink.base

  // Right trouser & boot (viewer right: forward, x=17..21, y=23..31)
  rect (17,23) (20,26) color=soil.2
  rect (17,26) (21,30) color=wood.2
  line (17,31) (21,31) color=ink.base
  line (18,27) (20,27) color=wood.3
  pixel (19,28) color=wood.4

  // Outlines & separation
  line (11,26) (11,29) color=ink.base
  line (16,23) (16,28) color=ink.base
  line (17,27) (17,30) color=ink.base
  line (21,27) (21,30) color=ink.base
}

frame "f4" {
  // Passing: right leg plant, left leg lifting
  // Left trouser & boot (viewer left: lifted slightly at y=23..29)
  rect (12,23) (15,25) color=soil.2
  rect (12,26) (15,28) color=wood.2
  line (12,29) (15,29) color=ink.base
  pixel (13,27) color=wood.3

  // Right trouser & boot (viewer right: plant at y=23..31)
  rect (17,23) (20,26) color=soil.2
  rect (17,27) (20,30) color=wood.2
  line (17,31) (20,31) color=ink.base
  pixel (18,28) color=wood.3

  // Outlines & separation
  line (11,26) (11,28) color=ink.base
  line (16,23) (16,30) color=ink.base
  line (21,27) (21,30) color=ink.base
}
