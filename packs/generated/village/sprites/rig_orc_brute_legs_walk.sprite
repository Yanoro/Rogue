sprite 32x32
kind object
material soil

frame "f1" {
  // Contact: Left leg forward & planted low, right leg trailing back
  // Left leg (viewer's left: x=12..16, y=21..31)
  rect (12,21) (16,31) color=ink.base
  // Right leg (viewer's right: trailing slightly, x=17..21, y=20..30)
  rect (17,20) (21,30) color=ink.base

  // Groin division
  line (16,21) (17,24) color=ink.base

  // Left breeches (y=21..24)
  rect (13,21) (15,24) color=soil.2
  line (13,21) (15,21) color=soil.3
  // Right breeches (y=20..23)
  rect (18,20) (20,23) color=soil.1

  // Leather wraps (Left y=25..27, Right y=24..26)
  rect (13,25) (15,27) color=wood.2
  pixel (13,25) color=wood.3
  pixel (14,26) color=wood.1
  rect (18,24) (20,26) color=wood.1
  pixel (18,24) color=wood.2

  // Boots (Left y=28..31, Right y=27..30)
  rect (12,28) (16,31) color=iron.1
  rect (17,27) (21,30) color=iron.0

  // Soles & toe caps
  line (12,31) (16,31) color=ink.base
  line (17,30) (21,30) color=ink.base
  line (12,28) (14,28) color=iron.3
  line (17,27) (19,27) color=iron.2
  pixel (13,30) color=iron.3
  pixel (18,29) color=iron.1

  // Iron studs
  pixel (13,29) color=iron.4
  pixel (15,29) color=iron.3
  pixel (18,28) color=iron.3

  scatter color=soil.0,soil.3 density=0.1 seed=11 inside
}

