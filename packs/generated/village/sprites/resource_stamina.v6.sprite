sprite 32x32
kind object
wrap off

palette {
  outline = #221019
  trachea_shadow = #7d828a
  trachea = #cdd2d9
  trachea_hi = #ffffff
  lung_shadow = #8c264d
  lung_dark = #be3a6a
  lung_mid = #e35d8c
  lung_light = #f78dae
  lung_hi = #ffc2d4
}

// Trachea / windpipe stem
rect (14,3) (17,11) color=outline
rect (15,4) (16,10) color=trachea
line (15,5) (16,5) color=trachea_hi
line (15,7) (16,7) color=trachea_hi
line (15,9) (16,9) color=trachea_hi
pixel (16,4) color=trachea_shadow
pixel (16,6) color=trachea_shadow
pixel (16,8) color=trachea_shadow
pixel (16,10) color=trachea_shadow

// Bronchial split behind lungs
line (13,10) (15,12) color=outline
line (18,10) (16,12) color=outline

// Main lung silhouettes (darkest base / outlines)
// Left lung outline
circle (10,13) radius=4 color=outline
circle (8,18) radius=5 color=outline
circle (10,23) radius=5 color=outline
polygon (6,15) (13,11) (13,24) (8,27) (5,22) color=outline

// Right lung outline (slightly larger, anatomically three-lobed shape)
circle (21,13) radius=4 color=outline
circle (23,18) radius=5 color=outline
circle (21,24) radius=5 color=outline
polygon (18,11) (25,15) (26,22) (23,27) (18,24) color=outline

// Clear inner margin where lungs separate around heart
rect (15,12) (16,28) color=#00000000
erase line (15,13) (15,26)
erase line (16,13) (16,26)

// Left lung body fill
circle (10,13) radius=3 color=lung_mid
circle (8,18) radius=4 color=lung_mid
circle (10,23) radius=4 color=lung_mid
polygon (7,14) (13,12) (13,24) (9,26) (6,21) color=lung_mid

// Right lung body fill
circle (21,13) radius=3 color=lung_mid
circle (23,18) radius=4 color=lung_mid
circle (21,24) radius=4 color=lung_mid
polygon (18,12) (24,14) (25,21) (22,26) (18,24) color=lung_mid

// Bottom shading (lung_dark and lung_shadow)
line (8,26) (11,26) color=lung_shadow
line (7,25) (12,25) color=lung_dark
line (6,22) (8,24) color=lung_shadow
pixel (12,24) color=lung_shadow

line (20,26) (23,26) color=lung_shadow
line (19,25) (24,25) color=lung_dark
line (23,24) (25,22) color=lung_shadow
pixel (19,24) color=lung_shadow

// Interior medial shade (near cardiac notch)
line (13,14) (13,23) color=lung_dark
line (18,14) (18,23) color=lung_dark
pixel (12,18) color=lung_shadow
pixel (12,19) color=lung_shadow
pixel (19,18) color=lung_shadow
pixel (19,19) color=lung_shadow

// Upper-left highlights (air / volume / shine)
// Left lobe highlights
circle (9,13) radius=2 color=lung_light
pixel (9,12) color=lung_hi
pixel (8,13) color=lung_hi
line (7,16) (7,19) color=lung_light
pixel (7,17) color=lung_hi
line (8,21) (9,22) color=lung_light

// Right lobe highlights
circle (20,13) radius=2 color=lung_light
pixel (20,12) color=lung_hi
pixel (19,13) color=lung_hi
line (22,16) (23,18) color=lung_light
pixel (22,17) color=lung_hi
line (20,21) (21,22) color=lung_light

// Bronchial tree fine branching inside left & right
line (11,15) (9,17) color=lung_shadow
line (9,17) (8,19) color=lung_shadow
line (10,18) (11,20) color=lung_shadow

line (20,15) (22,17) color=lung_shadow
line (22,17) (23,19) color=lung_shadow
line (21,18) (20,20) color=lung_shadow

// Subtle tissue texture
scatter color=lung_light,lung_dark density=0.08 seed=42 inside
