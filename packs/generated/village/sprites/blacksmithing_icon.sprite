sprite 32x32
kind object
material iron

palette {
  out = #1A1210
  light = #FFE0B8
  mid = #F2C79A
  dark = #C98B60
}

// --- Silhouette Base (Warm midtone) ---
// Anvil base, waist, and horn/face
polygon (8,28) (23,28) (21,25) (10,25) color=mid
polygon (11,25) (20,25) (18,21) (13,21) color=mid
polygon (5,18) (25,18) (26,21) (7,21) color=mid
// Ingot on anvil face
rect (12,15) (19,17) color=mid
// Hammer head striking down
polygon (11,10) (20,10) (20,14) (11,14) color=mid
// Hammer handle extending up-right
polygon (18,10) (25,3) (27,5) (20,12) color=mid

// --- Highlights & Shading (Flat two-tone) ---
// Anvil face top highlight
rect (6,18) (24,18) color=light
// Ingot highlight
rect (13,15) (18,16) color=light
// Hammer striking face highlight
rect (12,13) (19,13) color=light
// Hammer handle lighter edge
line (19,9) (26,2) color=light
// Anvil waist and base shadow
rect (13,22) (18,24) color=dark
line (9,27) (22,27) color=dark

// --- Outlines (Dark line art) ---
// Anvil base outline
line (7,29) (24,29) color=out
line (7,28) (10,25) color=out
line (24,28) (21,25) color=out
// Anvil waist
line (10,25) (12,21) color=out
line (21,25) (19,21) color=out
// Anvil horn & body
line (4,18) (26,18) color=out
line (4,18) (6,21) color=out
line (26,18) (27,21) color=out
line (6,21) (12,21) color=out
line (27,21) (19,21) color=out

// Ingot outline
line (11,15) (20,15) color=out
line (11,17) (20,17) color=out
line (11,15) (11,17) color=out
line (20,15) (20,17) color=out

// Hammer head outline
rect (10,9) (21,14) color=out
// Refill hammer head core
rect (11,10) (20,13) color=mid
rect (12,12) (19,13) color=light

// Hammer handle outline
line (19,10) (26,3) color=out
line (21,13) (28,6) color=out
line (26,3) (28,5) color=out
// Refill handle body
line (20,11) (27,4) color=dark

// --- Sparks at Impact ---
pixel (8,13) color=light
pixel (9,14) color=out
pixel (22,12) color=light
pixel (23,13) color=out
pixel (10,16) color=light
pixel (21,16) color=light
